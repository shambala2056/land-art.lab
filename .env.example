# Copy this file to .env for local `vercel dev` testing, and set the same
# keys in your Vercel project (Settings -> Environment Variables) for production.
#
# NEVER put a real secret in this file — it is committed. Only names, plus a
# couple of non-secret defaults. After changing anything in Vercel you must
# redeploy: environment variables are read at boot, so a running deployment
# keeps the old set.

# ── Card payments · 360 Finance / MongolID ecommerce ────────────────────────
# From the merchant agreement. These three move money — treat them like bank
# credentials. They are read only inside api/ functions, and are never sent to a
# browser, returned in a response, or written to a log.
MINU_USERNAME=
MINU_PASSWORD=
MINU_MERCHANT_CODE=

# Sandbox while testing, production once the merchant account is live:
#   https://api.minu.mn/oncom-test   (sandbox — the default when unset)
#   https://api.minu.mn/oncom        (production)
MINU_BASE_URL=

# Basic Auth credentials the PROVIDER uses when calling our /api/pay-callback.
# We invent these and hand them to 360 Finance. Deliberately separate from the
# three above, so a fault in the callback cannot expose the credentials that
# move money.
MINU_CALLBACK_USER=
MINU_CALLBACK_PASS=

# ── Sold-pit ledger · Vercel KV ─────────────────────────────────────────────
# Records which pits in which cell have been sold, so a cell cannot be sold
# twice over. Create a KV store in the Vercel dashboard (Storage → Create →
# KV) and connect it to this project; both values below are then set for you.
#
# If these are absent the site still takes payments — it simply cannot show a
# remaining count or refuse an oversale, and duplicates have to be reconciled
# by hand from the notification emails. A payment system that stops taking
# money because a cache is missing would be the worse failure.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Order book · Google Sheet ───────────────────────────────────────────────
# Every order is written to a Google Sheet: name, email, cell, pits, amount and
# status, plus columns a person fills in to record that the certificate was
# sent. Uses an Apps Script Web App rather than the Sheets API, so there is no
# service-account key to store and no SDK to install.
#
# Setup instructions are at the bottom of scripts/google-apps-script.gs.
# The secret matters: an Apps Script deployed for "anyone" is a public URL, and
# without it anyone who found it could write rows into the order book.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# ── Contact form, and payment notifications ─────────────────────────────────
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions and payment notifications are delivered.
CONTACT_TO_EMAIL=hello@shambala.today

# Optional: the "From" address emails are sent as. Until you verify your own
# domain in Resend, you must use their shared sandbox address below.
CONTACT_FROM_EMAIL="Land-Art Lab <onboarding@resend.dev>"
